---
import { content, socials, type Lang } from '../data/content';

const { lang = 'es' } = Astro.props as { lang?: Lang };
const t = content[lang];
const h = t.hero;
const projectsHref = `${t.prefix}/project`;
const contactHref = `${t.prefix}/contact`;
---

<main id="home" class="flex items-center pt-16">
  <div class="wrap grid items-center gap-12 py-16 md:grid-cols-[1.25fr_1fr] md:py-24 lg:gap-20">
    <div class="order-2 md:order-1">
      <h1 class="text-balance">
        <span data-enter style="--i: 0" class="mb-4 block text-lg text-muted sm:text-xl">{h.greeting}</span>
        <span data-enter style="--i: 1" class="block text-[clamp(2.75rem,8vw,5.5rem)] font-semibold leading-[0.98] tracking-[-0.035em]">
          Juan Llanos
        </span>
      </h1>
      <p data-enter style="--i: 2" class="mt-6 text-xl font-medium text-accent sm:text-2xl">{h.role}</p>
      <p data-enter style="--i: 3" class="mt-6 max-w-[52ch] text-pretty text-lg leading-relaxed text-muted">
        {h.body}
      </p>

      <div data-enter style="--i: 4" class="mt-10 flex flex-wrap items-center gap-3">
        <a href={projectsHref} class="btn btn-primary">{h.projects}</a>
        <a href={contactHref} class="btn btn-ghost">{h.contact}</a>
        <a href={h.cvHref} download aria-label={h.cvLabel} class="btn btn-ghost">{h.cv}</a>
      </div>

      <ul data-enter style="--i: 5" class="mt-10 flex gap-6 text-sm">
        <li>
          <a href={socials.github} target="_blank" rel="noopener noreferrer" class="link-u inline-flex items-center gap-2 text-muted transition-colors hover:text-fg">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
            GitHub
          </a>
        </li>
        <li>
          <a href={h.linkedin} target="_blank" rel="noopener noreferrer" class="link-u inline-flex items-center gap-2 text-muted transition-colors hover:text-fg">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg>
            LinkedIn
          </a>
        </li>
      </ul>
    </div>

    <div data-enter style="--i: 2" class="order-1 mx-auto w-full max-w-[18rem] md:order-2 md:max-w-none">
      <img
        src="/personal.webp"
        alt={h.photoAlt}
        width="1184"
        height="864"
        fetchpriority="high"
        class="aspect-[4/5] w-full rounded-3xl border border-line object-cover"
      />
    </div>
  </div>
</main>
