---
import { content, type Lang } from '../data/content';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = content[lang];
const other = content[lang === 'es' ? 'en' : 'es'];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const basePath = path.replace(/^\/en(?=\/|$)/, '') || '/';
const href = (p: string) => (t.prefix + (p === '/' ? '' : p)) || '/';
const switchHref = (other.prefix + (basePath === '/' ? '' : basePath)) || '/';

const links = [
  { path: '/', label: t.nav.home },
  { path: '/about', label: t.nav.about },
  { path: '/project', label: t.nav.projects },
  { path: '/contact', label: t.nav.contact },
];
---

<header class="site-nav fixed inset-x-0 top-0 z-50">
  <div class="wrap flex h-16 items-center justify-between">
    <a href={href('/')} class="text-base font-semibold tracking-tight">Juan Llanos</a>

    <nav aria-label={t.nav.primary} class="hidden items-center gap-8 text-sm md:flex">
      {links.map((l) => (
        <a
          href={href(l.path)}
          class="link-u text-muted transition-colors hover:text-fg aria-[current=page]:text-fg"
          aria-current={basePath === l.path ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
      <a
        href={switchHref}
        hreflang={other.htmlLang}
        lang={other.htmlLang}
        aria-label={t.otherLangName}
        class="rounded-full border border-line px-3 py-1 text-xs font-medium transition-colors hover:border-fg"
      >
        {t.otherLangLabel}
      </a>
    </nav>

    <button
      id="menu-button"
      type="button"
      aria-label={t.nav.menu}
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="-mr-2 grid h-11 w-11 place-items-center rounded-full md:hidden"
    >
      <span class="relative block h-3 w-6">
        <span class="bar absolute inset-x-0 top-0 h-px bg-current transition-transform duration-300"></span>
        <span class="bar absolute inset-x-0 bottom-0 h-px bg-current transition-transform duration-300"></span>
      </span>
    </button>
  </div>

  <nav id="mobile-menu" aria-label={t.nav.primary} hidden class="border-t border-line bg-bg md:hidden">
    <div class="wrap flex flex-col py-4">
      {links.map((l) => (
        <a
          href={href(l.path)}
          class="py-3 text-lg text-muted aria-[current=page]:text-fg"
          aria-current={basePath === l.path ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
      <a href={switchHref} hreflang={other.htmlLang} lang={other.htmlLang} class="py-3 text-lg text-muted">
        {t.otherLangName}
      </a>
    </div>
  </nav>
</header>

<style>
  #menu-button[aria-expanded='true'] .bar:first-child {
    transform: translateY(5.5px) rotate(45deg);
  }
  #menu-button[aria-expanded='true'] .bar:last-child {
    transform: translateY(-5.5px) rotate(-45deg);
  }
</style>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    button?.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
  }

  button?.addEventListener('click', () => {
    setOpen(button.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
