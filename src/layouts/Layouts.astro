---
import '../styles/global.css';
import favicon from '../assets/AstroIcon.svg?url';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../data/content';

interface Props {
  title: string;
  lang?: Lang;
  description?: string;
}

const {
  title,
  lang = 'es',
  description = 'Frontend Developer passionate about creating beautiful web experiences',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <NavBar lang={lang} />
  <slot />
  <Footer lang={lang} />
</body>
</html>
